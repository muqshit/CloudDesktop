{
  "name": "ABMMM Cloud PC",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Cloud PC Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "postStartCommand": "bash /usr/local/bin/start-desktop.sh"
}
